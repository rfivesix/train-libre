default_platform(:ios)

platform :ios do
  desc "Upload existing IPA to Apple TestFlight"
  lane :upload_beta do
    project_root = File.expand_path("../../..", __FILE__)
    pubspec_path = File.join(project_root, "pubspec.yaml")
    
    if File.exist?(pubspec_path)
      pubspec_content = File.read(pubspec_path)
      # Match version line: version: x.y.z+build_number
      version_match = pubspec_content.match(/^version:\s*[^\n]+\+(\d+)/)
      if version_match
        build_number = version_match[1]
        UI.message("Successfully parsed iOS build number from pubspec.yaml: #{build_number}")
      else
        UI.user_error!("Could not parse build number from pubspec.yaml version field.")
      end
    else
      UI.user_error!("pubspec.yaml not found at path: #{pubspec_path}")
    end

    # NOTE: Deliberately no increment_build_number here. This lane uploads an
    # already-built IPA, so setting the version afterwards cannot affect the
    # binary anyway -- and agvtool would rewrite the $(FLUTTER_BUILD_NUMBER)
    # placeholder in Runner/Info.plist back into a hardcoded literal, which is
    # exactly how that file got stuck at build 1000013. The build number comes
    # from pubspec.yaml via `flutter build ipa --build-number` in
    # script/deploy_release.sh; it is only parsed above to verify the IPA.

    ipa_path = Dir[File.join(project_root, "build", "ios", "ipa", "**", "*.ipa")].first
    
    UI.user_error!("No compiled IPA file found in build/ios/ipa/") unless ipa_path
    UI.message("Found compiled IPA for TestFlight at: #{ipa_path}")

    upload_to_testflight(
      ipa: ipa_path,
      app_identifier: "com.rfivesix.trainlibre",
      username: "accounts.richard@schotte.me", 
      apple_id: "6767055511",    
      team_id: "QUXZN5283U",
      skip_waiting_for_build_processing: true,
      changelog: "We are constantly working on improvements. To view the full changelog, please visit our GitHub repository."
    )
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do |options|
    screenshots_dir = options[:path] || File.expand_path("../screenshots", __FILE__)
    UI.message("Uploading screenshots from: #{screenshots_dir}")

    upload_to_app_store(
      app_identifier: "com.rfivesix.trainlibre",
      username: "accounts.richard@schotte.me",
      app: "6767055511",
      team_id: "QUXZN5283U",
      skip_binary_upload: true,
      skip_metadata: true,
      screenshots_path: screenshots_dir,
      overwrite_screenshots: true,
      force: true
    )
  end

  desc "Download store metadata from App Store Connect"
  lane :download_metadata do
    meta_dir = File.expand_path("../metadata", __FILE__)
    UI.message("Downloading metadata to: #{meta_dir}")

    sh("bundle exec fastlane deliver download_metadata --force --metadata_path '#{meta_dir}' --app_identifier 'com.rfivesix.trainlibre' --username 'accounts.richard@schotte.me' --team_id 'QUXZN5283U'")
  end

  desc "Upload store metadata to App Store Connect"
  lane :upload_metadata do
    meta_dir = File.expand_path("../metadata", __FILE__)
    UI.message("Uploading metadata from: #{meta_dir}")

    deliver(
      app_identifier: "com.rfivesix.trainlibre",
      username: "accounts.richard@schotte.me",
      app: "6767055511",
      team_id: "QUXZN5283U",
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: meta_dir,
      force: true
    )
  end
end