6_64"], "versionName": "1.0.0-beta.5", "versionCode": 1000006, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["7bea1cc437d23ad86535001c2996c22def49d8d75bd6b4942b6aad59572b17cc"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 28}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.health.READ_STEPS"}, {"name": "android.permission.health.READ_SLEEP"}, {"name": "android.permission.health.READ_HEART_RATE"}, {"name": "android.permission.health.WRITE_WEIGHT"}, {"name": "android.permission.health.WRITE_BODY_FAT"}, {"name": "android.permission.health.WRITE_NUTRITION"}, {"name": "android.permission.health.WRITE_HYDRATION"}, {"name": "android.permission.health.WRITE_EXERCISE"}, {"name": "android.permission.health.WRITE_DISTANCE"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "com.rfivesix.trainlibre.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}, "whatsNew": {"en-US": "\n### Added\n- **Opt-in Anonymous Telemetry & F-Droid Cleanliness Architecture:** Implemented a privacy-first, opt-in `TelemetryService` using PostHog EU (`https://eu.i.posthog.com`) with zero PII capture. Added an abstract `TelemetryService` interface with `NoOpTelemetryService` (stub for F-Droid and disabled builds using `--dart-define=DISABLE_TELEMETRY=true`) and `PostHogTelemetryService`. Added a user-facing toggle switch (\"Anonyme Nutzungsstatistiken teilen\") in Settings under *Support & Info", "de-DE": "\n### Added\n- **Opt-in Anonymous Telemetry & F-Droid Cleanliness Architecture:** Implemented a privacy-first, opt-in `TelemetryService` using PostHog EU (`https://eu.i.posthog.com`) with zero PII capture. Added an abstract `TelemetryService` interface with `NoOpTelemetryService` (stub for F-Droid and disabled builds using `--dart-define=DISABLE_TELEMETRY=true`) and `PostHogTelemetryService`. Added a user-facing toggle switch (\"Anonyme Nutzungsstatistiken teilen\") in Settings under *Support & Info"}}}}}}